# =============================================================================
# Archivo de Configuracion de Ejemplo (.env.example)
# Copie este archivo como '.env' en este mismo directorio (chatbotW/)
# y complete los valores correspondientes.
# =============================================================================

# 1. API Key de Google Gemini (CRITICO)
# Se puede configurar desde la UI de administracion en http://localhost:8000
# Obtenela de: https://aistudio.google.com/
GOOGLE_API_KEY=

# 2. Configuracion de Evolution API
EVOLUTION_API_KEY=franquitoGoat
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=rag_bot

# 3. Puertos del sistema
# Si algun puerto esta ocupado, el script de instalacion detectara
# automaticamente uno disponible y actualizara estas variables.
BOT_PORT=5000
ADMIN_PORT=8000
EVO_PORT=8080

# 4. URL del Webhook del Bot
# Este es el endpoint donde Evolution API enviara los mensajes recibidos.
# Se construye automaticamente a partir de BOT_PORT.
BOT_URL=http://bot.local:${BOT_PORT}/webhook

# 5. Credenciales de Evolution API (PostgreSQL)
# Solo se usan internamente entre contenedores Docker.
POSTGRES_USER=evo
POSTGRES_PASSWORD=evopass
POSTGRES_DB=evolution

# 6. API Key de Evolution API (autenticacion interna)
EVO_API_KEY=franquitoGoat
