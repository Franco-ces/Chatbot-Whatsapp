# =============================================================================
# Sample Configuration File (.env.example)
# Copy this file as '.env' in this same directory (chatbotW/)
# and fill in the corresponding values.
# =============================================================================

# 1. Google Gemini API Key (CRITICAL)
# Can be configured from the admin UI at http://localhost:8000
# Get yours from: https://aistudio.google.com/
GOOGLE_API_KEY=

# 2. Evolution API Configuration
EVOLUTION_API_KEY=franquitoGoat
EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_INSTANCE_NAME=rag_bot  # Optional. The admin panel (http://localhost:8000)
                                      # allows creating/activating instances without this variable.

# 2.5. Admin Panel Password (SHA-256)
# The installation script will prompt you to enter a password.
# To set it manually, generate the hash with:
#   echo -n "yourpassword" | sha256sum | cut -d' ' -f1
# Example with password "admin123":
#   echo -n "admin123" | sha256sum | cut -d' ' -f1
# ADMIN_PASSWORD_HASH=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9

# 3. System Ports
# If any port is occupied, the installation script will automatically detect
# an available one and update these variables.
BOT_PORT=5000
ADMIN_PORT=8000
EVO_PORT=8080

# 4. Bot Webhook URL
# This is the endpoint where Evolution API will send received messages.
# It is built automatically from BOT_PORT.
BOT_URL=http://bot.local:${BOT_PORT}/webhook

# 5. Evolution API Credentials (PostgreSQL)
# Used internally between Docker containers only.
POSTGRES_USER=evo
POSTGRES_PASSWORD=evopass
POSTGRES_DB=evolution
POSTGRES_HOST=evolution_postgres

# 6. Evolution API API Key (internal authentication)
EVO_API_KEY=franquitoGoat
