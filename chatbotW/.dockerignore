# Excluir archivos que viven en named volumes o que son host-specific
# del contexto de build. Sin esto, `COPY . .` en el Dockerfile
# embebe estos archivos en la imagen, lo que confunde al runtime
# (ej. el bot leeria /app/config_bot.json baked-in en vez del
# volume compartido con admin-ui).
config_bot.json
.env

# Generated / runtime artifacts (volumes o rebuildables)
cache/
logs/
vectorstore/

# Virtual environments (never bake into image)
venv/
.venv/
Scripts/
Include/
pyvenv.cfg

# Python bytecode/cache
__pycache__/
*.pyc

# Test cache
.pytest_cache/